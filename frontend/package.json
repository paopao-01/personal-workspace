{
  "name": "jobhub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen-types && tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "lint": "oxlint src",
    "typecheck": "tsc -b --noEmit",
    "gen-types": "openapi-typescript ../docs/jobhub/03-openapi.yaml -o src/api/generated/types.ts",
    "prepare": "npm run gen-types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "openapi-typescript": "^7.4.0",
    "oxlint": "^1.79.0",
    "typescript": "~5.6.3",
    "vite": "^8.2.2"
  }
}
